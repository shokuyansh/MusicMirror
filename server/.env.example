# Local development: leave the three Supabase settings empty.
APP_ENV=development
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173
DATA_DIR=data
MAX_UPLOAD_MB=20
MAX_STORAGE_MB=500
TRUST_PROXY=false

# Production: APP_ENV=production; exact HTTPS frontend origin above.
# Use Supabase's session pooler (IPv4, port 5432), with sslmode=require.
DATABASE_URL=
SUPABASE_URL=
# Server-only secret key (sb_secret_...) or legacy service_role key. Never anon.
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=music
